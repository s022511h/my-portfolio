// ---------------------------------------------------------------------------
// routes.config.js — single source of truth for public routes.
//
// Consumed by:
//   - vue.config.js       → which routes get prerendered to static HTML
//   - generate-sitemap.js → which routes go in sitemap.xml
//
// Adding a page? Add it here once. Both consumers pick it up automatically.
//
// DO NOT ADD:
//   - Redirect-only paths (/cv, /launch, /600-websites, /7-day-websites,
//     /results, /free-audit, /website-audit) — these are 301s in vercel.json.
//   - Auth routes (/login, /register, /profile, /admin, /verify-email,
//     /forgot-password) — blocked in robots.txt, and Firebase hangs the render.
//   - /projects — Projects.vue was deleted.
//
// `lastmod` is optional. Set it by hand (YYYY-MM-DD) when you meaningfully
// update a page. Anything without one falls back to the build date.
// ---------------------------------------------------------------------------

module.exports = [
  // Homepage
  { url: '/',                     changefreq: 'weekly',  priority: 1.0 },

  // Money pages — the ones you want ranking for commercial terms
  { url: '/services/google-ads',  changefreq: 'monthly', priority: 0.9 },
  { url: '/services/seo',         changefreq: 'monthly', priority: 0.9 },
  { url: '/services/web-design',  changefreq: 'monthly', priority: 0.9 },
  { url: '/launch-sites',         changefreq: 'monthly', priority: 0.9 },
  { url: '/pricing',              changefreq: 'monthly', priority: 0.9 },

  // Proof
  { url: '/case-studies',         changefreq: 'weekly',  priority: 0.9 },
  { url: '/work',                 changefreq: 'weekly',  priority: 0.8 },

  // Conversion
  { url: '/contact',              changefreq: 'monthly', priority: 0.8 },
  { url: '/audit',                changefreq: 'monthly', priority: 0.8 },

  // Supporting
  { url: '/services',             changefreq: 'monthly', priority: 0.7 },
  { url: '/about',                changefreq: 'monthly', priority: 0.7 },
  { url: '/blog',                 changefreq: 'weekly',  priority: 0.7 },
  { url: '/portfolio',            changefreq: 'monthly', priority: 0.5 },
  { url: '/resume',               changefreq: 'monthly', priority: 0.4 },

  // Legal
  { url: '/privacy',              changefreq: 'yearly',  priority: 0.3 },
  { url: '/terms',                changefreq: 'yearly',  priority: 0.3 }
]